<% summary = roadmap.summary %>

<div class="flex justify-end margin-block-end">
  <div class="btn__group roadmap__view-switch flex flex-wrap" role="group" aria-label="Roadmap view">
    <%= button_to "List", my_roadmap_view_path, method: :patch,
          params: { roadmap_view: "list", board_id: @board.id },
          class: "btn", aria: { pressed: @view == "list" } %>

    <%= button_to "Lanes", my_roadmap_view_path, method: :patch,
          params: { roadmap_view: "lanes", board_id: @board.id },
          class: "btn", aria: { pressed: @view == "lanes" } %>
  </div>
</div>

<div class="roadmap__hero flex flex-column margin-block-end-double">
  <div class="roadmap__hero-top flex flex-wrap">
    <div class="roadmap__ring">
      <%= roadmap_progress_ring(summary.completion_percent) %>
      <div class="roadmap__ring-label">
        <strong class="roadmap__tabular txt-large font-weight-bold"><%= summary.completion_percent %>%</strong>
        <span class="roadmap__eyebrow txt-x-small txt-uppercase txt-subtle">done</span>
      </div>
    </div>

    <div class="roadmap__hero-stat flex flex-column gap-none">
      <div>
        <strong class="txt-x-large font-weight-bold"><%= summary.shipped %></strong><span class="txt-medium txt-subtle"> / <%= summary.total_cards %> shipped</span>
      </div>
      <span class="roadmap__eyebrow txt-x-small txt-uppercase txt-subtle">Delivery momentum</span>
    </div>
  </div>

  <ul class="roadmap__tiles flex flex-wrap margin-none unpad list-style-none">
    <li class="roadmap__tile gap-half txt-small">
      <span class="roadmap__tile-dot roadmap__status--in-flight" aria-hidden="true"></span>
      <strong class="font-weight-semibold"><%= summary.in_flight %></strong> In flight
    </li>
    <li class="roadmap__tile gap-half txt-small">
      <span class="roadmap__tile-dot roadmap__status--stalled" aria-hidden="true"></span>
      <strong class="font-weight-semibold"><%= summary.stalled %></strong> Stalled
    </li>
    <li class="roadmap__tile gap-half txt-small">
      <span class="roadmap__tile-dot roadmap__status--deferred" aria-hidden="true"></span>
      <strong class="font-weight-semibold"><%= summary.deferred %></strong> Not now
    </li>
    <li class="roadmap__tile gap-half txt-small">
      <span class="roadmap__tile-dot roadmap__status--planned" aria-hidden="true"></span>
      <strong class="font-weight-semibold"><%= summary.planned %></strong> Planned
    </li>
    <li class="roadmap__tile gap-half txt-small">
      <span class="roadmap__tile-dot roadmap__status--shipped" aria-hidden="true"></span>
      <strong class="font-weight-semibold"><%= summary.epics_shipped %>/<%= summary.total_epics %></strong> Epics shipped
    </li>
  </ul>
</div>
