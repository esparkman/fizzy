<% phase_id = "roadmap_phase_#{phase_group.label.parameterize}" %>

<section id="<%= phase_id %>" class="roadmap__phase margin-block-end-double" data-controller="roadmap-collapse">
  <div class="roadmap__phase-head">
    <button type="button" class="btn btn--plain roadmap__disclosure" aria-expanded="true" aria-controls="<%= phase_id %>_body" data-roadmap-collapse-target="button" data-action="click->roadmap-collapse#toggle">
      <%= icon_tag "caret-down" %>
      <span class="for-screen-reader">Toggle <%= phase_group.title %></span>
    </button>

    <h2 class="divider divider--fade flex-item-grow txt-medium font-weight-semibold">
      <span class="overflow-ellipsis"><%= phase_group.title %></span>
    </h2>

    <span class="roadmap__phase-done txt-small txt-subtle flex-item-no-shrink"><%= phase_group.rollup.shipped %>/<%= phase_group.rollup.total %> shipped</span>
  </div>

  <%= render "meter", rollup: phase_group.rollup %>

  <div id="<%= phase_id %>_body" data-roadmap-collapse-target="body">
    <ul class="roadmap__cards flex flex-column gap-half margin-none unpad margin-block-start-half">
      <%= render partial: "boards/roadmaps/roadmap_card", collection: phase_group.ordered_cards, as: :roadmap_card %>
    </ul>
  </div>
</section>
